# Local environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
.DS_Store
.idea/
.vscode/

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Private planning and generated artifacts
tmp_files/
build/
dist/
*.egg-info/
